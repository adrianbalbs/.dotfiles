{{ if eq .chezmoi.hostname "work" -}}
#!/bin/bash

# Fedora does not have Starship in its package manager
if ! command -v starship &>/dev/null; then
    echo "Starship not installed"

    if ! curl -sS https://starship.rs/install.sh | sh -s -- -y; then
        echo "Error: starsip install failed"
        exit 1
    fi
fi

echo " Enabling COPR repositories"

{{ range .packages.fedora.copr -}}
if sudo dnf copr list | grep -q "{{ . }}"; then
    echo "COPR already enabled: {{ . }}"
else
    echo "Enabling COPR: {{ . }}"
    sudo dnf copr enable -y {{ . }}
fi
{{ end -}}

echo "Installing packages..."

if ! sudo dnf install -y {{ .packages.fedora.dnf | join " " -}}; then
    echo "Error: dnf failed to install packages"
    exit 1
fi

echo "Finished installing all packages"
exit 0
{{ end -}}
