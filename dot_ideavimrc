" .ideavimrc is a configuration file for IdeaVim plugin. It uses
"   the same commands as the original .vimrc configuration.
" You can find a list of commands here: https://jb.gg/h38q75
" Find more examples here: https://jb.gg/share-ideavimrc


"" -- Suggested options --
" Show a few lines of context around the cursor. Note that this makes the
" text scroll if you mouse-click near the start or end of the window.
set scrolloff=5

" Use the OS ke
set clipboard+=unnamed

" Do incremental searching.
set incsearch
set relativenumber
set ideajoin

let mapleader = " "

" Don't use Ex mode, use Q for formatting.
map Q gq


" --- Enable IdeaVim plugins https://jb.gg/ideavim-plugins

" Highlight copied text
Plug 'machakann/vim-highlightedyank'
" Commentary plugin
Plug 'tpope/vim-commentary'
Plug 'preservim/nerdtree'

" Pane navigation
nnoremap <C-h> <C-w>h
nnoremap <C-l> <C-w>l
nnoremap <C-k> <C-w>k
nnoremap <C-j> <C-w>j

nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz

" Indentation
vnoremap < <gv
vnoremap > >gv

vnoremap J :m '>+1<CR>gv=gv
vnoremap K :m '<-2<CR>gv=gv

" TODO: Find a way to override menu autocomplete
" imap <C-p> <Action>(HippieBackwardCompletion)
" imap <C-n> <Action>(HippieCompletion)

map <leader>wv <Action>(SplitVertically)
map <leader>ws <Action>(SplitHorizontally)

map ]e <Action>(GotoNextError)
map [e <Action>(GotoPreviousError)
map [f <Action>(MethodUp)
map ]f <Action>(MethodDown)

map [b <Action>(PreviousTab)
map ]b <Action>(NextTab)

map <leader>bd <Action>(CloseEditor)
map <leader>ba <Action>(CloseAllEditors)

map <leader>gb <Action>(Annotate)
map <leader>z <Action>(ToggleDistractionFreeMode)
map <leader>o <Action>(FileStructurePopup)
map <leader>s <Action>(SelectInProjectView)

map <leader>d <Action>(Debug)
map <leader>db <Action>(Debug)

map <leader>cr <Action>(RenameElement)
map <leader>ca <Action>(QuickActions)
map <leader>ca <Action>(Refactorings.QuickListPopupAction)

map gr <Action>(FindUsages)
map gi <Action>(GotoImplementation)

